<resources>

    <style name="Theme.BV.TV.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="postSplashScreenTheme">@style/Theme.BV.TV</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.BV.TV" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 窗口底色与应用背景一致，避免转场时露出 Material3 默认的紫灰色 -->
        <item name="android:windowBackground">#FF0F0F10</item>
        <item name="android:colorBackground">#FF0F0F10</item>
    </style>
</resources>